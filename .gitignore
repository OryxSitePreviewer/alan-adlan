# committing them. They are large binaries and they change every export.
*.glb
*.obj
*.stl

# Source artwork drops. Keep originals in your own asset store, not the repo,
# unless they are small and final.
*.ai
*.eps
*.psd
*.zip

# Logs
*.log
npm-debug.log*

.vercel
